#!/usr/bin/env python3
"""
ZeroLoop CI Verification & Grader Script
========================================
Usage:
    zeroloop-check [--summary] [--audit] [--verbose] [--help]

Audits:
1. Zero external runtime dependencies in zeroloop-py (100% standard library).
2. Unit tests execution and sub-5ms rehydration performance.
3. Idempotency replay and cryptographic hash chaining integrity.
4. Bridge integrity (ZeroMCP, HyperGate, ZeroLeak, AgentTrace).
"""

import sys
import os
import ast
import argparse
import subprocess
import time

if sys.platform == "win32" or getattr(sys.stdout, "encoding", None) != "utf-8":
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
        sys.stderr.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass

SCRIPTS_DIR = os.path.dirname(os.path.abspath(__file__))
PROJECT_ROOT = os.path.dirname(SCRIPTS_DIR)
ZEROLOOP_PY = os.path.join(PROJECT_ROOT, "zeroloop-py", "zeroloop.py")

STD_MODULES = {
    "os", "sys", "json", "time", "uuid", "shutil", "hashlib", "sqlite3",
    "datetime", "argparse", "functools", "enum", "dataclasses", "typing",
    "contextlib", "unittest", "tempfile", "copy", "re", "threading"
}


def audit_dependencies(verbose=False):
    print("🔍 Auditing Runtime Dependencies in zeroloop.py...")
    with open(ZEROLOOP_PY, "r", encoding="utf-8") as f:
        tree = ast.parse(f.read(), filename=ZEROLOOP_PY)

    disallowed = set()
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                root_pkg = alias.name.split(".")[0]
                if root_pkg not in STD_MODULES:
                    disallowed.add(root_pkg)
        elif isinstance(node, ast.ImportFrom):
            if node.module:
                root_pkg = node.module.split(".")[0]
                if root_pkg not in STD_MODULES:
                    disallowed.add(root_pkg)

    if disallowed:
        print(f"  ❌ Zero Runtime Bloat Violated! Found external dependencies: {disallowed}")
        return False
    print("  ✅ Verified 100% Pure Standard Library. Zero external dependencies.")
    return True


def run_unit_tests(verbose=False):
    print("\n🧪 Running ZeroLoop Core Unit Tests...")
    test_path = os.path.join(PROJECT_ROOT, "tests", "test_zeroloop.py")
    t0 = time.time()
    res = subprocess.run([sys.executable, test_path], capture_output=True, text=True)
    dt = time.time() - t0

    if res.returncode != 0:
        print(f"  ❌ Core Unit Tests FAILED in {dt:.3f}s:\n{res.stderr}")
        return False
    print(f"  ✅ Core Unit Tests PASSED in {dt:.3f}s.")
    return True


def run_bridge_tests(verbose=False):
    print("\n🌉 Running ZeroLoop Integration Bridge Tests...")
    test_path = os.path.join(PROJECT_ROOT, "tests", "test_bridges.py")
    t0 = time.time()
    res = subprocess.run([sys.executable, test_path], capture_output=True, text=True)
    dt = time.time() - t0

    if res.returncode != 0:
        print(f"  ❌ Bridge Tests FAILED in {dt:.3f}s:\n{res.stderr}")
        return False
    print(f"  ✅ Bridge Tests PASSED in {dt:.3f}s.")
    return True


def audit_rust_crate(verbose=False):
    print("\n🦀 Auditing Rust Crate zeroloop-rs...")
    rs_dir = os.path.join(PROJECT_ROOT, "zeroloop-rs")
    cargo_toml = os.path.join(rs_dir, "Cargo.toml")
    if not os.path.exists(cargo_toml):
        print("  ❌ zeroloop-rs/Cargo.toml missing!")
        return False

    req_sources = ["lib.rs", "state.rs", "journal.rs", "pruning.rs", "main.rs"]
    for src in req_sources:
        p = os.path.join(rs_dir, "src", src)
        if not os.path.exists(p):
            print(f"  ❌ zeroloop-rs/src/{src} missing!")
            return False

    # If cargo is installed on the host, run cargo check
    import shutil
    if shutil.which("cargo"):
        print("  ⚙️  Running cargo check on zeroloop-rs...")
        res = subprocess.run(["cargo", "check"], cwd=rs_dir, capture_output=True, text=True)
        if res.returncode != 0:
            print(f"  ❌ cargo check failed:\n{res.stderr}")
            return False
        print("  ✅ cargo check PASSED.")
    else:
        print("  ✅ zeroloop-rs sources and Cargo manifest verified (cargo not present on local host).")

    return True


def main():
    parser = argparse.ArgumentParser(description="ZeroLoop CI Grader & Conformance Auditor.")
    parser.add_argument("--audit", action="store_true", help="Audit dependencies and invariants")
    parser.add_argument("--summary", action="store_true", help="Print summary scorecard")
    parser.add_argument("--verbose", "-v", action="store_true", help="Verbose diagnostic output")

    args = parser.parse_args()

    print("⚡ ZeroLoop Production Readiness & Conformance Grader")
    print("=" * 60)

    ok_deps = audit_dependencies(args.verbose)
    ok_core = run_unit_tests(args.verbose)
    ok_bridges = run_bridge_tests(args.verbose)
    ok_rust = audit_rust_crate(args.verbose)

    print("\n" + "=" * 60)
    all_ok = ok_deps and ok_core and ok_bridges and ok_rust
    if all_ok:
        print("🎉 ALL ZEROLOOP CONFORMANCE CHECKS PASSED (100% Academic Reliability)")
        sys.exit(0)
    else:
        print("🛑 ONE OR MORE AUDIT CRITERIA FAILED")
        sys.exit(1)


if __name__ == "__main__":
    main()
